PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5440/wagering
LOCK_TIMEOUT_MS=3000
AUTH_MODE=noop
LOG_LEVEL=info
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_DLQ_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
WORKERS_ENABLED=true
SQS_WAIT_TIME_SECONDS=5
