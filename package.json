{
  "name": "jungle-wagering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration --timeout 30000",
    "db:migrate": "bun run src/infrastructure/persistence/migrate.ts up",
    "db:rollback": "bun run src/infrastructure/persistence/migrate.ts down"
  },
  "dependencies": {
    "@mikro-orm/core": "6.6.16",
    "@mikro-orm/migrations": "6.6.16",
    "@mikro-orm/postgresql": "6.6.16",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "typescript": "5.9.3"
  }
}
